PROJECT_NAME="Intelligent Air Quality Monitoring System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration
# Default to SQLite for zero-friction local run; switch to PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/air_quality_db"
DATABASE_URL="sqlite:///./air_quality.db"

# Security & JWT (CRITICAL: Replace SECRET_KEY with a secure 32+ character random string in production)
SECRET_KEY="development-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Development Demo Credentials
# NOTE: These are non-production development defaults. In production, provide strong, secret values.
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@aeropulse.org"
ADMIN_PASSWORD="Admin@12345"

# Optional development accounts for analyst & viewer roles (seeded only when ENVIRONMENT != production)
ANALYST_USERNAME="analyst"
ANALYST_EMAIL="analyst@aeropulse.org"
ANALYST_PASSWORD="Analyst@12345"

VIEWER_USERNAME="viewer"
VIEWER_EMAIL="viewer@aeropulse.org"
VIEWER_PASSWORD="Viewer@12345"
